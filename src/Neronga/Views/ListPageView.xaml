<UserControl x:Class="Neronga.Views.ListPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Neronga.Localization"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Neronga.ViewModels"
             d:DataContext="{d:DesignInstance vm:ListPageViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/mc"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:ScannedItemViewModel}">
            <Border Padding="10,8" Margin="0,1" CornerRadius="6" Background="Transparent">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon Grid.Column="0" Symbol="{Binding KindSymbol}" Margin="0,2,12,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Top" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13.5" />
                            <ui:SymbolIcon Symbol="Info24" FontSize="13" Margin="6,0,0,0"
                                           Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}"
                                           ToolTip="{Binding Note}"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding FullPath}" FontSize="11.5" Opacity="0.65" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding FullPath}" />
                        <TextBlock FontSize="11" Opacity="0.55" Margin="0,2,0,0">
                            <Run Text="{Binding Label, Mode=OneWay}" />
                            <Run Text="{loc:T common.separator}" />
                            <Run Text="{Binding ScopeLabel, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="11.5" Opacity="0.6"
                               VerticalAlignment="Center" Margin="8,0" />
                    <TextBlock Grid.Column="3" Text="{Binding ModifiedText}" FontSize="11.5" Opacity="0.6"
                               VerticalAlignment="Center" Margin="8,0" Width="100" />

                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                        <ui:Button Appearance="Transparent" ToolTip="{loc:T list.tooltip.openFolder}" Command="{Binding OpenContainingFolderCommand}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="FolderOpen24" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Appearance="Transparent" ToolTip="{loc:T list.tooltip.copyPath}" Command="{Binding CopyPathCommand}" Margin="2,0,0,0">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Copy24" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Appearance="Transparent" ToolTip="{loc:T list.tooltip.edit}" Command="{Binding EditCommand}" Margin="2,0,0,0"
                                    Visibility="{Binding IsEditable, Converter={StaticResource BoolToVis}}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Edit24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>

                    <ui:Button Grid.Column="5" Appearance="Secondary" Content="{loc:T list.hide}" Margin="8,0,0,0"
                               Command="{Binding HideCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="EyeOff24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:VendorGroupViewModel}">
            <Border Margin="0,0,0,10" CornerRadius="8"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                  Style="{StaticResource NerongaGroupHeaderToggle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Vendor}" FontWeight="SemiBold" FontSize="14.5" VerticalAlignment="Center" />
                            <Border Background="{StaticResource NerongaYellowBrush}" CornerRadius="9" Margin="10,0,0,0"
                                    Padding="8,1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Count}" FontSize="11"
                                           Foreground="{StaticResource NerongaInkBrush}" FontWeight="Bold" />
                            </Border>
                        </StackPanel>
                    </ToggleButton>
                    <ItemsControl ItemsSource="{Binding Items}" Focusable="False" Margin="8,0,8,8"
                                  Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 検索バー -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox Grid.Column="0" PlaceholderText="{loc:T list.search.placeholder}"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        ClearButtonEnabled="True" Padding="10,8">
                <ui:TextBox.Icon>
                    <ui:SymbolIcon Symbol="Search24" />
                </ui:TextBox.Icon>
            </ui:TextBox>
            <ui:Button Grid.Column="1" Margin="10,0,0,0" Content="{loc:T list.rescan}" Appearance="Primary" Foreground="{StaticResource NerongaInkBrush}"
                       Command="{Binding RescanCommand}" IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBool}}">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="ArrowSync24" />
                </ui:Button.Icon>
            </ui:Button>
        </Grid>

        <!-- ウェルカムカード / 通知 -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <ui:InfoBar Margin="0,0,0,8"
                        IsOpen="{Binding ShowWelcomeCard}" IsClosable="True"
                        Title="{loc:T list.welcome.title}"
                        Message="{loc:T list.welcome.message}"
                        Severity="Informational" />

            <ui:InfoBar
                        IsOpen="{Binding HasNoWorkspaceRoots}" IsClosable="False"
                        Title="{loc:T list.noWorkspace.title}"
                        Message="{loc:T list.noWorkspace.message}"
                        Severity="Warning" />
        </StackPanel>

        <!-- 一覧 -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Groups}" Focusable="False" />

                <TextBlock Text="{loc:T list.empty}" Margin="4,40,0,0" Opacity="0.6"
                           HorizontalAlignment="Center"
                           Visibility="{Binding TotalItemCount, Converter={StaticResource ZeroToVis}}" />
            </StackPanel>
        </ScrollViewer>

        <!-- ステータスバー -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding StatusText}" Opacity="0.6" FontSize="12" VerticalAlignment="Center" />
            <ui:ProgressRing Grid.Column="1" IsIndeterminate="True" Width="18" Height="18"
                              Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />
        </Grid>
    </Grid>
</UserControl>
