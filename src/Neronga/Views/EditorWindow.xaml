<ui:FluentWindow x:Class="Neronga.Views.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Neronga.Localization"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:Neronga.ViewModels"
        d:DataContext="{d:DesignInstance vm:EditorWindowViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008/mc"
        mc:Ignorable="d"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="{Binding TitleText}" Height="740" Width="1180" MinHeight="420" MinWidth="760"
        WindowBackdropType="Mica" ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterOwner">

    <ui:FluentWindow.Resources>
        <DataTemplate DataType="{x:Type vm:HistoryEntryViewModel}">
            <StackPanel Margin="10,6">
                <TextBlock Text="{Binding WhenText}" FontWeight="SemiBold" FontSize="12.5" />
                <TextBlock Text="{Binding Message}" FontSize="11.5" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding ShortSha}" FontSize="10.5" Opacity="0.45" FontFamily="Consolas" />
            </StackPanel>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding TitleText}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="16,10,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- エディタ -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{Binding PathText}" FontSize="11.5" Opacity="0.6" Margin="2,0,0,6"
                           TextTrimming="CharacterEllipsis" />
                <Border Grid.Row="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                    <TextBox Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                             FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="13.5"
                             Padding="10" BorderThickness="0" Background="Transparent" />
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" />

            <!-- 変更履歴 / 差分 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="3*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{loc:T editor.history.title}" FontWeight="SemiBold" Margin="4,0,0,6" />
                <Border Grid.Row="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                    <ListBox ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistoryEntry, Mode=TwoWay}"
                             BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </Border>
                <ui:Button Grid.Row="2" Content="{loc:T editor.history.restore}" Margin="0,6,0,0" HorizontalAlignment="Stretch"
                           Appearance="Secondary" Command="{Binding RestoreSelectedVersionCommand}"
                           IsEnabled="{Binding IsDiffVisible}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ArrowUndo24" />
                    </ui:Button.Icon>
                </ui:Button>

                <TextBlock Grid.Row="4" Text="{loc:T editor.diff.title}" FontWeight="SemiBold" Margin="4,10,0,6" />
                <Border Grid.Row="5" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding DiffText, Converter={StaticResource SplitLines}}" Margin="8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="12"
                                               Foreground="{Binding Converter={StaticResource DiffLineBrush}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Margin="16,0,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding StatusText}" Opacity="0.6" FontSize="12" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button Content="{loc:T editor.save}" Appearance="Primary" Foreground="{StaticResource NerongaInkBrush}" Command="{Binding SaveCommand}" Margin="0,0,8,0"
                           IsEnabled="{Binding IsDirty}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Save24" />
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button Content="{loc:T editor.close}" Appearance="Secondary" Command="{Binding CloseCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
