<UserControl x:Class="Neronga.Views.SettingsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Neronga.Localization"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Neronga.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/mc"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance vm:SettingsPageViewModel}">

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:PathEntryRowViewModel}">
            <Border Padding="12,9" Margin="0,2" CornerRadius="6" Background="Transparent">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:ToggleSwitch Grid.Column="0" IsChecked="{Binding Enabled, Mode=TwoWay}" Margin="0,0,12,0" />

                    <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontWeight="SemiBold" FontSize="13">
                                <Run Text="{Binding Vendor, Mode=OneWay}" />
                                <Run Text="{loc:T common.separator}" />
                                <Run Text="{Binding Label, Mode=OneWay}" />
                            </TextBlock>
                            <ui:SymbolIcon Symbol="Info24" FontSize="12" Margin="6,0,0,0"
                                           Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}"
                                           ToolTip="{Binding Note}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="4" Margin="8,0,0,0" Padding="5,0">
                                <TextBlock Text="{loc:T settings.entry.userAdded}" FontSize="10" Opacity="0.6"
                                           Visibility="{Binding IsBuiltIn, Converter={StaticResource InverseBoolToVis}}" />
                            </Border>
                        </StackPanel>
                        <TextBlock FontSize="11.5" Opacity="0.6" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding KindLabel, Mode=OneWay}" />
                            <Run Text="{loc:T common.separator}" />
                            <Run Text="{Binding ScopeLabel, Mode=OneWay}" />
                            <Run Text="{loc:T common.separator}" />
                            <Run Text="{Binding PathTemplate, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <ui:Button Grid.Column="2" Appearance="Transparent" ToolTip="{loc:T common.open}" Command="{Binding OpenInExplorerCommand}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="FolderOpen24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Grid.Column="3" Appearance="Transparent" ToolTip="{loc:T common.delete}" Command="{Binding RemoveCommand}" Margin="4,0,0,0">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Delete24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="WorkspaceRootItemTemplate">
            <Border Padding="12,8" Margin="0,2" CornerRadius="6" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <ui:Button Grid.Column="1" Appearance="Transparent" ToolTip="{loc:T common.delete}"
                               Command="{Binding DataContext.RemoveWorkspaceRootCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               CommandParameter="{Binding}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Delete24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16,24,32">
            <TextBlock Text="{loc:T settings.title}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16" />

            <!-- プロジェクトルート -->
            <TextBlock Text="{loc:T settings.roots.title}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Text="{loc:T settings.roots.desc}"
                       FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,10" />
            <ItemsControl ItemsSource="{Binding WorkspaceRoots}" ItemTemplate="{StaticResource WorkspaceRootItemTemplate}" Focusable="False" />
            <ui:Button Content="{loc:T settings.roots.add}" Appearance="Secondary" Command="{Binding AddWorkspaceRootCommand}"
                       HorizontalAlignment="Left" Margin="0,8,0,0">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Add24" />
                </ui:Button.Icon>
            </ui:Button>

            <Separator Margin="0,20" />

            <!-- スキャン設定 -->
            <TextBlock Text="{loc:T settings.scan.title}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:T settings.scan.depth}" VerticalAlignment="Center" />
                <ui:NumberBox Grid.Column="1" Value="{Binding WorkspaceScanDepth, Mode=TwoWay}"
                              Minimum="1" Maximum="30" SpinButtonPlacementMode="Inline" HorizontalAlignment="Left" Width="140" />
            </Grid>
            <TextBlock Text="{loc:T settings.scan.excluded}" Margin="0,6,0,4" />
            <ui:TextBox Text="{Binding ExcludedFolderNamesText, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" TextWrapping="Wrap" />

            <Separator Margin="0,20" />

            <!-- 外観 -->
            <TextBlock Text="{loc:T settings.appearance.title}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:T settings.appearance.theme}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding ThemeOptions}"
                          SelectedItem="{Binding ThemeSelection, Mode=TwoWay}" Width="160" />
                <TextBlock Grid.Column="2" Text="{loc:T settings.appearance.language}" VerticalAlignment="Center" Margin="28,0,12,0" />
                <ComboBox Grid.Column="3" ItemsSource="{Binding LanguageOptions}"
                          SelectedItem="{Binding LanguageSelection, Mode=TwoWay}" Width="160" />
            </Grid>

            <Separator Margin="0,20" />

            <!-- パス定義の追加 -->
            <TextBlock Text="{loc:T settings.add.title}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <ui:TextBox PlaceholderText="{loc:T settings.add.vendor}" Text="{Binding NewVendor, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />
                    <ui:TextBox PlaceholderText="{loc:T settings.add.label}" Text="{Binding NewLabel, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0" PlaceholderText="{loc:T settings.add.path}"
                                    Text="{Binding NewPath, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button Grid.Column="1" Content="{loc:T settings.add.browse}" Command="{Binding BrowseNewPathCommand}" Margin="6,0,0,0" />
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{loc:T settings.add.kind}" FontSize="11" Opacity="0.6" />
                    <ComboBox ItemsSource="{Binding KindOptions}" SelectedItem="{Binding NewKind, Mode=TwoWay}" Margin="0,2,0,6">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource KindLabel}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{loc:T settings.add.scope}" FontSize="11" Opacity="0.6" />
                    <ComboBox ItemsSource="{Binding ScopeOptions}" SelectedItem="{Binding NewScope, Mode=TwoWay}" Margin="0,2,0,6">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource ScopeLabel}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ui:Button Content="{loc:T settings.add.submit}" Appearance="Primary" Foreground="{StaticResource NerongaInkBrush}" Command="{Binding AddEntryCommand}" HorizontalAlignment="Right">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Add24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </Grid>

            <Separator Margin="0,20" />

            <!-- 監視パス一覧 -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:T settings.entries.title}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                <ui:Button Grid.Column="1" Content="{loc:T settings.entries.reset}" Appearance="Secondary" Command="{Binding ResetToDefaultsCommand}" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Entries}" Focusable="False" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
