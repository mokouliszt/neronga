<UserControl x:Class="Neronga.Views.HiddenPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Neronga.Localization"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Neronga.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/mc"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance vm:HiddenPageViewModel}">

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:HiddenItemViewModel}">
            <Border Padding="14,10" Margin="0,4" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock FontWeight="SemiBold" FontSize="13.5">
                            <Run Text="{Binding Vendor, Mode=OneWay}" />
                            <Run Text="{loc:T common.separator}" />
                            <Run Text="{Binding Label, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding OriginalPath}" FontSize="11.5" Opacity="0.65"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding OriginalPath}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding KindLabel}" Opacity="0.6" FontSize="11.5"
                               VerticalAlignment="Center" Margin="10,0" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="10,0" Opacity="0.6" FontSize="11.5">
                        <Run Text="{loc:T hidden.at}" /><Run Text="{Binding HiddenAtText, Mode=OneWay}" />
                    </TextBlock>
                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <ui:Button Content="{loc:T hidden.restore}" Appearance="Primary" Foreground="{StaticResource NerongaInkBrush}" Command="{Binding RestoreCommand}" Margin="0,0,6,0">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="ArrowUndo24" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Content="{loc:T hidden.deleteForever}" Appearance="Danger" Command="{Binding DeleteForeverCommand}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Delete24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="{loc:T hidden.title}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            <ui:Button Content="{loc:T common.refresh}" Appearance="Secondary" Command="{Binding ReloadCommand}" Margin="14,0,0,0">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="ArrowSync24" />
                </ui:Button.Icon>
            </ui:Button>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Items}" Focusable="False" />
                <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                            HorizontalAlignment="Center" Margin="0,60,0,0">
                    <ui:SymbolIcon Symbol="EyeOff24" FontSize="32" Opacity="0.4" HorizontalAlignment="Center" />
                    <TextBlock Text="{loc:T hidden.empty}" Opacity="0.6" Margin="0,10,0,0" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
