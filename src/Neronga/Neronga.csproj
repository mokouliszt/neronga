<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Neronga</RootNamespace>
    <AssemblyName>neronga</AssemblyName>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>neronga</Product>
    <Company>mokouliszt</Company>
    <Authors>mokouliszt</Authors>
    <Description>AIエージェント各社のskills / カスタム指示ファイル / MCP設定を一覧・整理するためのWindowsツール</Description>
    <Copyright>Copyright (c) 2026 mokouliszt</Copyright>
    <PackAsTool>false</PackAsTool>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NeutralLanguage>ja</NeutralLanguage>

    <!-- Single-file self-contained publish defaults (used by `dotnet publish`) -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SatelliteResourceLanguages>ja;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="LibGit2Sharp" Version="0.32.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

</Project>
