<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- アイコンから抽出した黄色をブランドカラーとして使用 -->
    <Color x:Key="NerongaYellowColor">#FEE704</Color>
    <Color x:Key="NerongaYellowDeepColor">#C9AE00</Color>
    <Color x:Key="NerongaYellowSoftColor">#FFF6B8</Color>
    <Color x:Key="NerongaInkColor">#1A1A17</Color>

    <SolidColorBrush x:Key="NerongaYellowBrush" Color="{StaticResource NerongaYellowColor}" />
    <SolidColorBrush x:Key="NerongaYellowDeepBrush" Color="{StaticResource NerongaYellowDeepColor}" />
    <SolidColorBrush x:Key="NerongaYellowSoftBrush" Color="{StaticResource NerongaYellowSoftColor}" />
    <SolidColorBrush x:Key="NerongaInkBrush" Color="{StaticResource NerongaInkColor}" />

    <!-- グレー階調 -->
    <Color x:Key="NerongaGray900Color">#1F1F1F</Color>
    <Color x:Key="NerongaGray700Color">#3A3A3A</Color>
    <Color x:Key="NerongaGray500Color">#6E6E6E</Color>
    <Color x:Key="NerongaGray300Color">#B9B9B9</Color>
    <Color x:Key="NerongaGray200Color">#E2E2E2</Color>
    <Color x:Key="NerongaGray100Color">#F3F3F1</Color>

    <SolidColorBrush x:Key="NerongaGray900Brush" Color="{StaticResource NerongaGray900Color}" />
    <SolidColorBrush x:Key="NerongaGray700Brush" Color="{StaticResource NerongaGray700Color}" />
    <SolidColorBrush x:Key="NerongaGray500Brush" Color="{StaticResource NerongaGray500Color}" />
    <SolidColorBrush x:Key="NerongaGray300Brush" Color="{StaticResource NerongaGray300Color}" />
    <SolidColorBrush x:Key="NerongaGray200Brush" Color="{StaticResource NerongaGray200Color}" />
    <SolidColorBrush x:Key="NerongaGray100Brush" Color="{StaticResource NerongaGray100Color}" />

    <!--
      WPF-UI のアクセント関連ブラシの上書き。
      アクセント色が明るい黄色のため、既定の白文字だと読めなくなる。
      このディクショナリは App.xaml で ThemesDictionary より後にマージしているため、
      テーマ切り替え（ThemesDictionary の差し替え）後もこちらの定義が優先される。
    -->
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="{StaticResource NerongaInkColor}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#2E2E29" />
    <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush" Color="#8A1A1A17" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSelectedTextBrush" Color="{StaticResource NerongaInkColor}" />

    <!-- 通常背景の上にアクセント色で描く文字。黄色のままだと明背景で読めないため深い金色にする。 -->
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#9A8200" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#9A8200" />
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#8A7400" />

    <!-- ベンダーグループの展開ヘッダー。外部テンプレートに依存せず自前で構成する。 -->
    <Style x:Key="NerongaGroupHeaderToggle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Chevron" Grid.Column="0" Text="&#x25BE;" FontSize="13"
                                       Margin="0,0,10,0" VerticalAlignment="Center" Opacity="0.7" />
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="Chevron" Property="Text" Value="&#x25B8;" />
                        </Trigger>
                        <!-- Content 内の要素はコントロール自身から Foreground を継承する。 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource NerongaYellowSoftBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource NerongaInkBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ナビレールの選択状態表現に使用 -->
    <Style x:Key="NerongaNavRadioButton" TargetType="RadioButton">
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Margin" Value="8,3" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="8" Padding="{TemplateBinding Padding}" Background="Transparent">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Content 内の要素は論理親（コントロール自身）から Foreground を継承するため、
                             Border ではなくコントロール自身に設定しないと効かない。
                             選択状態がホバーに勝つよう、IsChecked を後に置いている。 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource NerongaYellowSoftBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource NerongaInkBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource NerongaYellowBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource NerongaInkBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
